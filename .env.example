# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321   # comma-separated Telegram user IDs

# ── FunPay ────────────────────────────────────────────────────────────────────
FUNPAY_GOLDEN_KEY=your_golden_key_cookie_here
FUNPAY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ── Fragment / TON ────────────────────────────────────────────────────────────
# Mnemonics for TON wallet used to pay on Fragment (24 words space-separated)
TON_WALLET_MNEMONIC=word1 word2 word3 ... word24
# Optional: proxy for Fragment requests (e.g. http://user:pass@host:port)
FRAGMENT_PROXY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
